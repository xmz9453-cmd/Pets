# Database Configuration (Development: psop_dev, Production: psop_one)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=psop_dev
DB_USER=your_non_root_user
DB_PASSWORD=your_local_password

TEST_DB_NAME=psop_test

# Ports & Base URLs (Production: NEXT_PUBLIC_API_BASE_URL= for same-origin /api)
BACKEND_PORT=3001
FRONTEND_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
CONTRACT_STORAGE_ROOT=D:\MVP-data\contracts
SHOP_LOGO_STORAGE_ROOT=D:\MVP-data\shop-logos
PORTAL_BACKGROUND_STORAGE_ROOT=D:\MVP-data\portal-backgrounds

# Customer login providers are optional. Keep all credentials on the backend.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LINE_LOGIN_CALLBACK_URL=http://localhost:3001/api/public/member/auth/line/callback
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/public/member/auth/google/callback
CUSTOMER_AUTH_RETURN_URL=http://localhost:3000/booking

# System Owner Initialization (Development / Setup only)
AUTH_FOUNDATION_OWNER_USERNAME=owner
AUTH_FOUNDATION_OWNER_PASSWORD=foundation-password
AUTH_FOUNDATION_OWNER_DISPLAY_NAME=Foundation Owner
