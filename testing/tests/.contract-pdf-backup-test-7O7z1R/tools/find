#!/usr/bin/env bash
legacy_scan=0
for argument in "$@"; do
  if [ "$argument" = "-mindepth" ]; then
    legacy_scan=1
  fi
done
if [ "${MOCK_FIND_FAILURE:-0}" = "1" ] && [ "$legacy_scan" = "1" ]; then
  printf 'legacy scan attempted\n' > "$MOCK_FIND_MARKER"
  echo "injected find permission failure" >&2
  exit 13
fi
exec /usr/bin/find "$@"
